/*
 * This file is generated by CMake at build time.
 */

#ifndef COAL_WARNING_HH
#define COAL_WARNING_HH

// Emits a warning in a portable way.
#define COAL_WARN_STRINGISE_IMPL(x) #x
#define COAL_WARN_STRINGISE(x) COAL_WARN_STRINGISE_IMPL(x)
#ifdef __GNUC__
#define COAL_WARN(exp) ("WARNING: " exp)
#else
#ifdef _MSC_VER
#define FILE_LINE_LINK __FILE__ "(" COAL_WARN_STRINGISE(__LINE__) ") : "
#define COAL_WARN(exp) (FILE_LINE_LINK "WARNING: " exp)
#else
#define COAL_WARN(MSG) /* nothing */
#endif  // _MSC_VER
#endif  // __GNUC__

#endif  // COAL_WARNING_HH
